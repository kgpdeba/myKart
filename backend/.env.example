PORT=8000
mongoUrl=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eKart?retryWrites=true&w=majority
secretKey=your_jwt_secret_key

# Frontend Client URL (Set to your Render frontend domain in production)
CLIENT_URL=http://localhost:5173

# Brevo (Sendinblue) Email Configuration for Render
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key
BREVO_SENDER_EMAIL=your_verified_brevo_sender_email@domain.com
BREVO_SENDER_NAME=eKart

# Cloudinary Configuration for Product Image Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration
RAZORPAY_API_KEY=your_razorpay_key_id
RAZORPAY_API_SECRET=your_razorpay_key_secret
